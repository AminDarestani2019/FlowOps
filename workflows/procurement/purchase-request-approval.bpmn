<?xml version="1.0" encoding="UTF-8"?>

<bpmn:definitions
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_PurchaseRequestApproval"
    targetNamespace="http://flowops.local/procurement">

  <bpmn:process
      id="purchase-request-approval"
      name="Purchase Request Approval"
      isExecutable="true">

    <!-- ================================================= -->
    <!-- START                                             -->
    <!-- ================================================= -->

    <bpmn:startEvent
        id="StartEvent_Submitted"
        name="Purchase Request Submitted">
      <bpmn:outgoing>Flow_Start_To_ApprovalPolicy</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- ================================================= -->
    <!-- DMN                                               -->
    <!-- ================================================= -->

    <bpmn:businessRuleTask
        id="BusinessRuleTask_DetermineApprovalLevel"
        name="Determine Approval Level">

      <bpmn:extensionElements>
        <zeebe:calledDecision
            decisionId="approvalLevel"
            bindingType="deployment"
            resultVariable="approvalLevel" />
      </bpmn:extensionElements>

      <bpmn:incoming>Flow_Start_To_ApprovalPolicy</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalPolicy_To_Manager</bpmn:outgoing>

    </bpmn:businessRuleTask>

    <!-- ================================================= -->
    <!-- MANAGER                                           -->
    <!-- ================================================= -->

    <bpmn:userTask
        id="UserTask_ManagerApproval"
        name="Manager Approval">

      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>

      <bpmn:incoming>Flow_ApprovalPolicy_To_Manager</bpmn:incoming>
      <bpmn:outgoing>Flow_Manager_To_Decision</bpmn:outgoing>

    </bpmn:userTask>

    <bpmn:exclusiveGateway
        id="Gateway_ManagerDecision"
        name="Manager Decision">

      <bpmn:incoming>Flow_Manager_To_Decision</bpmn:incoming>

      <bpmn:outgoing>
        Flow_ManagerDecision_To_Rejected
      </bpmn:outgoing>

      <bpmn:outgoing>
        Flow_ManagerDecision_To_Routing
      </bpmn:outgoing>

    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway
        id="Gateway_AfterManager"
        name="Approval Level Routing">

      <bpmn:incoming>
        Flow_ManagerDecision_To_Routing
      </bpmn:incoming>

      <bpmn:outgoing>
        Flow_ManagerRoute_Manager_To_Procurement
      </bpmn:outgoing>

      <bpmn:outgoing>
        Flow_ManagerRoute_ManagerFinance_To_Finance
      </bpmn:outgoing>

      <bpmn:outgoing>
        Flow_ManagerRoute_ManagerFinanceDirector_To_Finance
      </bpmn:outgoing>

    </bpmn:exclusiveGateway>

    <!-- ================================================= -->
    <!-- FINANCE                                           -->
    <!-- ================================================= -->

    <bpmn:userTask
        id="UserTask_FinanceApproval"
        name="Finance Approval">

      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>

      <bpmn:incoming>
        Flow_ManagerRoute_ManagerFinance_To_Finance
      </bpmn:incoming>

      <bpmn:incoming>
        Flow_ManagerRoute_ManagerFinanceDirector_To_Finance
      </bpmn:incoming>

      <bpmn:outgoing>
        Flow_Finance_To_Decision
      </bpmn:outgoing>

    </bpmn:userTask>

    <bpmn:exclusiveGateway
        id="Gateway_FinanceDecision"
        name="Finance Decision">

      <bpmn:incoming>
        Flow_Finance_To_Decision
      </bpmn:incoming>

      <bpmn:outgoing>
        Flow_FinanceDecision_To_Rejected
      </bpmn:outgoing>

      <bpmn:outgoing>
        Flow_FinanceDecision_To_Routing
      </bpmn:outgoing>

    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway
        id="Gateway_AfterFinance"
        name="Finance Routing">

      <bpmn:incoming>
        Flow_FinanceDecision_To_Routing
      </bpmn:incoming>

      <bpmn:outgoing>
        Flow_FinanceRoute_ManagerFinance_To_Procurement
      </bpmn:outgoing>

      <bpmn:outgoing>
        Flow_FinanceRoute_ManagerFinanceDirector_To_Director
      </bpmn:outgoing>

    </bpmn:exclusiveGateway>

    <!-- ================================================= -->
    <!-- DIRECTOR                                          -->
    <!-- ================================================= -->

    <bpmn:userTask
        id="UserTask_DirectorApproval"
        name="Director Approval">

      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>

      <bpmn:incoming>
        Flow_FinanceRoute_ManagerFinanceDirector_To_Director
      </bpmn:incoming>

      <bpmn:outgoing>
        Flow_Director_To_Decision
      </bpmn:outgoing>

    </bpmn:userTask>

    <bpmn:exclusiveGateway
        id="Gateway_DirectorDecision"
        name="Director Decision">

      <bpmn:incoming>
        Flow_Director_To_Decision
      </bpmn:incoming>

      <bpmn:outgoing>
        Flow_DirectorDecision_To_Rejected
      </bpmn:outgoing>

      <bpmn:outgoing>
        Flow_DirectorDecision_To_Procurement
      </bpmn:outgoing>

    </bpmn:exclusiveGateway>

    <!-- ================================================= -->
    <!-- PROCUREMENT                                       -->
    <!-- ================================================= -->

    <bpmn:userTask
        id="UserTask_ProcurementApproval"
        name="Procurement Approval">

      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>

      <bpmn:incoming>
        Flow_ManagerRoute_Manager_To_Procurement
      </bpmn:incoming>

      <bpmn:incoming>
        Flow_FinanceRoute_ManagerFinance_To_Procurement
      </bpmn:incoming>

      <bpmn:incoming>
        Flow_DirectorDecision_To_Procurement
      </bpmn:incoming>

      <bpmn:outgoing>
        Flow_Procurement_To_Decision
      </bpmn:outgoing>

    </bpmn:userTask>

    <bpmn:exclusiveGateway
        id="Gateway_ProcurementDecision"
        name="Procurement Decision">

      <bpmn:incoming>
        Flow_Procurement_To_Decision
      </bpmn:incoming>

      <bpmn:outgoing>
        Flow_ProcurementDecision_To_Approved
      </bpmn:outgoing>

      <bpmn:outgoing>
        Flow_ProcurementDecision_To_Rejected
      </bpmn:outgoing>

    </bpmn:exclusiveGateway>

    <!-- ================================================= -->
    <!-- END EVENTS                                        -->
    <!-- ================================================= -->

    <bpmn:endEvent
        id="EndEvent_Approved"
        name="Approved">

      <bpmn:incoming>
        Flow_ProcurementDecision_To_Approved
      </bpmn:incoming>

    </bpmn:endEvent>

    <bpmn:endEvent
        id="EndEvent_Rejected"
        name="Rejected">

      <bpmn:incoming>
        Flow_ManagerDecision_To_Rejected
      </bpmn:incoming>

      <bpmn:incoming>
        Flow_FinanceDecision_To_Rejected
      </bpmn:incoming>

      <bpmn:incoming>
        Flow_DirectorDecision_To_Rejected
      </bpmn:incoming>

      <bpmn:incoming>
        Flow_ProcurementDecision_To_Rejected
      </bpmn:incoming>

    </bpmn:endEvent>

    <!-- ================================================= -->
    <!-- SEQUENCE FLOWS                                    -->
    <!-- ================================================= -->

    <bpmn:sequenceFlow
        id="Flow_Start_To_ApprovalPolicy"
        sourceRef="StartEvent_Submitted"
        targetRef="BusinessRuleTask_DetermineApprovalLevel" />

    <bpmn:sequenceFlow
        id="Flow_ApprovalPolicy_To_Manager"
        sourceRef="BusinessRuleTask_DetermineApprovalLevel"
        targetRef="UserTask_ManagerApproval" />

    <!-- Manager -->

    <bpmn:sequenceFlow
        id="Flow_Manager_To_Decision"
        sourceRef="UserTask_ManagerApproval"
        targetRef="Gateway_ManagerDecision" />

    <bpmn:sequenceFlow
        id="Flow_ManagerDecision_To_Rejected"
        name="Rejected"
        sourceRef="Gateway_ManagerDecision"
        targetRef="EndEvent_Rejected">

      <bpmn:conditionExpression
          xsi:type="bpmn:tFormalExpression">
        = decision = "rejected"
      </bpmn:conditionExpression>

    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow
        id="Flow_ManagerDecision_To_Routing"
        name="Approved"
        sourceRef="Gateway_ManagerDecision"
        targetRef="Gateway_AfterManager">

      <bpmn:conditionExpression
          xsi:type="bpmn:tFormalExpression">
        = decision = "approved"
      </bpmn:conditionExpression>

    </bpmn:sequenceFlow>

    <!-- After Manager -->

    <bpmn:sequenceFlow
        id="Flow_ManagerRoute_Manager_To_Procurement"
        name="Manager Only"
        sourceRef="Gateway_AfterManager"
        targetRef="UserTask_ProcurementApproval">

      <bpmn:conditionExpression
          xsi:type="bpmn:tFormalExpression">
        = approvalLevel = "MANAGER"
      </bpmn:conditionExpression>

    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow
        id="Flow_ManagerRoute_ManagerFinance_To_Finance"
        name="Manager + Finance"
        sourceRef="Gateway_AfterManager"
        targetRef="UserTask_FinanceApproval">

      <bpmn:conditionExpression
          xsi:type="bpmn:tFormalExpression">
        = approvalLevel = "MANAGER_FINANCE"
      </bpmn:conditionExpression>

    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow
        id="Flow_ManagerRoute_ManagerFinanceDirector_To_Finance"
        name="Manager + Finance + Director"
        sourceRef="Gateway_AfterManager"
        targetRef="UserTask_FinanceApproval">

      <bpmn:conditionExpression
          xsi:type="bpmn:tFormalExpression">
        = approvalLevel = "MANAGER_FINANCE_DIRECTOR"
      </bpmn:conditionExpression>

    </bpmn:sequenceFlow>

    <!-- Finance -->

    <bpmn:sequenceFlow
        id="Flow_Finance_To_Decision"
        sourceRef="UserTask_FinanceApproval"
        targetRef="Gateway_FinanceDecision" />

    <bpmn:sequenceFlow
        id="Flow_FinanceDecision_To_Rejected"
        name="Rejected"
        sourceRef="Gateway_FinanceDecision"
        targetRef="EndEvent_Rejected">

      <bpmn:conditionExpression
          xsi:type="bpmn:tFormalExpression">
        = decision = "rejected"
      </bpmn:conditionExpression>

    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow
        id="Flow_FinanceDecision_To_Routing"
        name="Approved"
        sourceRef="Gateway_FinanceDecision"
        targetRef="Gateway_AfterFinance">

      <bpmn:conditionExpression
          xsi:type="bpmn:tFormalExpression">
        = decision = "approved"
      </bpmn:conditionExpression>

    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow
        id="Flow_FinanceRoute_ManagerFinance_To_Procurement"
        name="Procurement Next"
        sourceRef="Gateway_AfterFinance"
        targetRef="UserTask_ProcurementApproval">

      <bpmn:conditionExpression
          xsi:type="bpmn:tFormalExpression">
        = approvalLevel = "MANAGER_FINANCE"
      </bpmn:conditionExpression>

    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow
        id="Flow_FinanceRoute_ManagerFinanceDirector_To_Director"
        name="Director Next"
        sourceRef="Gateway_AfterFinance"
        targetRef="UserTask_DirectorApproval">

      <bpmn:conditionExpression
          xsi:type="bpmn:tFormalExpression">
        = approvalLevel = "MANAGER_FINANCE_DIRECTOR"
      </bpmn:conditionExpression>

    </bpmn:sequenceFlow>

    <!-- Director -->

    <bpmn:sequenceFlow
        id="Flow_Director_To_Decision"
        sourceRef="UserTask_DirectorApproval"
        targetRef="Gateway_DirectorDecision" />

    <bpmn:sequenceFlow
        id="Flow_DirectorDecision_To_Rejected"
        name="Rejected"
        sourceRef="Gateway_DirectorDecision"
        targetRef="EndEvent_Rejected">

      <bpmn:conditionExpression
          xsi:type="bpmn:tFormalExpression">
        = decision = "rejected"
      </bpmn:conditionExpression>

    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow
        id="Flow_DirectorDecision_To_Procurement"
        name="Approved"
        sourceRef="Gateway_DirectorDecision"
        targetRef="UserTask_ProcurementApproval">

      <bpmn:conditionExpression
          xsi:type="bpmn:tFormalExpression">
        = decision = "approved"
      </bpmn:conditionExpression>

    </bpmn:sequenceFlow>

    <!-- Procurement -->

    <bpmn:sequenceFlow
        id="Flow_Procurement_To_Decision"
        sourceRef="UserTask_ProcurementApproval"
        targetRef="Gateway_ProcurementDecision" />

    <bpmn:sequenceFlow
        id="Flow_ProcurementDecision_To_Approved"
        name="Approved"
        sourceRef="Gateway_ProcurementDecision"
        targetRef="EndEvent_Approved">

      <bpmn:conditionExpression
          xsi:type="bpmn:tFormalExpression">
        = decision = "approved"
      </bpmn:conditionExpression>

    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow
        id="Flow_ProcurementDecision_To_Rejected"
        name="Rejected"
        sourceRef="Gateway_ProcurementDecision"
        targetRef="EndEvent_Rejected">

      <bpmn:conditionExpression
          xsi:type="bpmn:tFormalExpression">
        = decision = "rejected"
      </bpmn:conditionExpression>

    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- =================================================== -->
  <!-- DIAGRAM                                             -->
  <!-- =================================================== -->

  <bpmndi:BPMNDiagram
      id="BPMNDiagram_PurchaseRequestApproval">

    <bpmndi:BPMNPlane
        id="BPMNPlane_PurchaseRequestApproval"
        bpmnElement="purchase-request-approval">

      <bpmndi:BPMNShape
          id="Shape_StartEvent_Submitted"
          bpmnElement="StartEvent_Submitted">
        <dc:Bounds x="80" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Shape_BusinessRuleTask_DetermineApprovalLevel"
          bpmnElement="BusinessRuleTask_DetermineApprovalLevel">
        <dc:Bounds x="160" y="250" width="140" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Shape_UserTask_ManagerApproval"
          bpmnElement="UserTask_ManagerApproval">
        <dc:Bounds x="350" y="250" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Shape_Gateway_ManagerDecision"
          bpmnElement="Gateway_ManagerDecision"
          isMarkerVisible="true">
        <dc:Bounds x="520" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Shape_Gateway_AfterManager"
          bpmnElement="Gateway_AfterManager"
          isMarkerVisible="true">
        <dc:Bounds x="620" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Shape_UserTask_FinanceApproval"
          bpmnElement="UserTask_FinanceApproval">
        <dc:Bounds x="730" y="250" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Shape_Gateway_FinanceDecision"
          bpmnElement="Gateway_FinanceDecision"
          isMarkerVisible="true">
        <dc:Bounds x="900" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Shape_Gateway_AfterFinance"
          bpmnElement="Gateway_AfterFinance"
          isMarkerVisible="true">
        <dc:Bounds x="1000" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Shape_UserTask_DirectorApproval"
          bpmnElement="UserTask_DirectorApproval">
        <dc:Bounds x="1110" y="250" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Shape_Gateway_DirectorDecision"
          bpmnElement="Gateway_DirectorDecision"
          isMarkerVisible="true">
        <dc:Bounds x="1280" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Shape_UserTask_ProcurementApproval"
          bpmnElement="UserTask_ProcurementApproval">
        <dc:Bounds x="1390" y="250" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Shape_Gateway_ProcurementDecision"
          bpmnElement="Gateway_ProcurementDecision"
          isMarkerVisible="true">
        <dc:Bounds x="1570" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Shape_EndEvent_Approved"
          bpmnElement="EndEvent_Approved">
        <dc:Bounds x="1690" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Shape_EndEvent_Rejected"
          bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="1090" y="470" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge
          id="Edge_Flow_Start_To_ApprovalPolicy"
          bpmnElement="Flow_Start_To_ApprovalPolicy">
        <di:waypoint x="116" y="290" />
        <di:waypoint x="160" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_ApprovalPolicy_To_Manager"
          bpmnElement="Flow_ApprovalPolicy_To_Manager">
        <di:waypoint x="300" y="290" />
        <di:waypoint x="350" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_Manager_To_Decision"
          bpmnElement="Flow_Manager_To_Decision">
        <di:waypoint x="470" y="290" />
        <di:waypoint x="520" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_ManagerDecision_To_Routing"
          bpmnElement="Flow_ManagerDecision_To_Routing">
        <di:waypoint x="570" y="290" />
        <di:waypoint x="620" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_ManagerRoute_Manager_To_Procurement"
          bpmnElement="Flow_ManagerRoute_Manager_To_Procurement">
        <di:waypoint x="645" y="265" />
        <di:waypoint x="645" y="200" />
        <di:waypoint x="1455" y="200" />
        <di:waypoint x="1455" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_ManagerRoute_ManagerFinance_To_Finance"
          bpmnElement="Flow_ManagerRoute_ManagerFinance_To_Finance">
        <di:waypoint x="670" y="290" />
        <di:waypoint x="730" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_ManagerRoute_ManagerFinanceDirector_To_Finance"
          bpmnElement="Flow_ManagerRoute_ManagerFinanceDirector_To_Finance">
        <di:waypoint x="645" y="315" />
        <di:waypoint x="645" y="350" />
        <di:waypoint x="790" y="350" />
        <di:waypoint x="790" y="330" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_Finance_To_Decision"
          bpmnElement="Flow_Finance_To_Decision">
        <di:waypoint x="850" y="290" />
        <di:waypoint x="900" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_FinanceDecision_To_Routing"
          bpmnElement="Flow_FinanceDecision_To_Routing">
        <di:waypoint x="950" y="290" />
        <di:waypoint x="1000" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_FinanceRoute_ManagerFinance_To_Procurement"
          bpmnElement="Flow_FinanceRoute_ManagerFinance_To_Procurement">
        <di:waypoint x="1025" y="265" />
        <di:waypoint x="1025" y="200" />
        <di:waypoint x="1455" y="200" />
        <di:waypoint x="1455" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_FinanceRoute_ManagerFinanceDirector_To_Director"
          bpmnElement="Flow_FinanceRoute_ManagerFinanceDirector_To_Director">
        <di:waypoint x="1050" y="290" />
        <di:waypoint x="1110" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_Director_To_Decision"
          bpmnElement="Flow_Director_To_Decision">
        <di:waypoint x="1230" y="290" />
        <di:waypoint x="1280" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_DirectorDecision_To_Procurement"
          bpmnElement="Flow_DirectorDecision_To_Procurement">
        <di:waypoint x="1330" y="290" />
        <di:waypoint x="1390" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_Procurement_To_Decision"
          bpmnElement="Flow_Procurement_To_Decision">
        <di:waypoint x="1520" y="290" />
        <di:waypoint x="1570" y="290" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_ProcurementDecision_To_Approved"
          bpmnElement="Flow_ProcurementDecision_To_Approved">
        <di:waypoint x="1620" y="290" />
        <di:waypoint x="1690" y="290" />
      </bpmndi:BPMNEdge>

      <!-- Rejection paths -->

      <bpmndi:BPMNEdge
          id="Edge_Flow_ManagerDecision_To_Rejected"
          bpmnElement="Flow_ManagerDecision_To_Rejected">
        <di:waypoint x="545" y="315" />
        <di:waypoint x="545" y="488" />
        <di:waypoint x="1090" y="488" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_FinanceDecision_To_Rejected"
          bpmnElement="Flow_FinanceDecision_To_Rejected"> 
        <di:waypoint x="925" y="315" />
        <di:waypoint x="925" y="488" />
        <di:waypoint x="1090" y="488" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_DirectorDecision_To_Rejected"
          bpmnElement="Flow_DirectorDecision_To_Rejected">
        <di:waypoint x="1305" y="315" />
        <di:waypoint x="1305" y="488" />
        <di:waypoint x="1126" y="488" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
          id="Edge_Flow_ProcurementDecision_To_Rejected"
          bpmnElement="Flow_ProcurementDecision_To_Rejected">
        <di:waypoint x="1595" y="315" />
        <di:waypoint x="1595" y="488" />
        <di:waypoint x="1126" y="488" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>

  </bpmndi:BPMNDiagram>

</bpmn:definitions>