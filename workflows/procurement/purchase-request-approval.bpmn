        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1nzoi1z_di" bpmnElement="ServiceTask_SubProcess_RecordApprovalAudit">
        <dc:Bounds x="2209" y="570" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_0lm82rn_di" bpmnElement="Gateway_SubProcess_PostApprovalJoin">
        <dc:Bounds x="2424" y="445" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2335" y="460" width="69" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_02lw413_di" bpmnElement="EndEvent_SubProcess_PostApproval">
        <dc:Bounds x="3282" y="422" width="36" height="36" />
