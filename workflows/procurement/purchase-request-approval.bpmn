<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_PurchaseRequestApproval" targetNamespace="http://flowops.local/procurement" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="purchase-request-approval" name="Purchase Request Approval" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Submitted" name="Purchase Request Submitted">
      <bpmn:outgoing>Flow_Start_To_ApprovalPolicy</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="BusinessRuleTask_DetermineApprovalLevel" name="Determine Approval Level">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="approvalLevel" resultVariable="approvalLevel" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_ApprovalPolicy</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalPolicy_To_Manager</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="UserTask_ManagerApproval" name="Manager Approval">
      <bpmn:extensionElements>
        <zeebe:taskSchedule dueDate="= now() + duration(&quot;PT24H&quot;)" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApprovalPolicy_To_Manager</bpmn:incoming>
      <bpmn:outgoing>Flow_Manager_To_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ManagerDecision" name="Manager Decision">
      <bpmn:incoming>Flow_Manager_To_Decision</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_AfterManager" name="Approval Level Routing" />
    <bpmn:userTask id="UserTask_FinanceApproval" name="Finance Approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FinanceDecision" name="Finance Decision" />
    <bpmn:exclusiveGateway id="Gateway_AfterFinance" name="Finance Routing" />
    <bpmn:userTask id="UserTask_DirectorApproval" name="Director Approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DirectorDecision" name="Director Decision" />
    <bpmn:userTask id="UserTask_ProcurementApproval" name="Procurement Approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ProcurementDecision" name="Procurement Decision">
      <bpmn:outgoing>Flow_1if7nxc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Approved" name="Approved">
      <bpmn:incoming>Flow_06tp7t7</bpmn:incoming>
      <bpmn:incoming>Flow_1ya2xxt</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Rejected" name="Rejected" />
    <bpmn:sequenceFlow id="Flow_Start_To_ApprovalPolicy" sourceRef="StartEvent_Submitted" targetRef="BusinessRuleTask_DetermineApprovalLevel" />
    <bpmn:sequenceFlow id="Flow_ApprovalPolicy_To_Manager" sourceRef="BusinessRuleTask_DetermineApprovalLevel" targetRef="UserTask_ManagerApproval" />
    <bpmn:sequenceFlow id="Flow_Manager_To_Decision" sourceRef="UserTask_ManagerApproval" targetRef="Gateway_ManagerDecision" />
    <bpmn:sequenceFlow id="Flow_ManagerDecision_To_Rejected" name="Rejected" sourceRef="Gateway_ManagerDecision" targetRef="EndEvent_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        = decision = "rejected"
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerDecision_To_Routing" name="Approved" sourceRef="Gateway_ManagerDecision" targetRef="Gateway_AfterManager">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        = decision = "approved"
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerRoute_Manager_To_Procurement" name="Manager Only" sourceRef="Gateway_AfterManager" targetRef="UserTask_ProcurementApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        = approvalLevel = "MANAGER"
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerRoute_ManagerFinance_To_Finance" name="Manager + Finance" sourceRef="Gateway_AfterManager" targetRef="UserTask_FinanceApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        = approvalLevel = "MANAGER_FINANCE"
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerRoute_ManagerFinanceDirector_To_Finance" name="Manager + Finance + Director" sourceRef="Gateway_AfterManager" targetRef="UserTask_FinanceApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        = approvalLevel = "MANAGER_FINANCE_DIRECTOR"
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Finance_To_Decision" sourceRef="UserTask_FinanceApproval" targetRef="Gateway_FinanceDecision" />
    <bpmn:sequenceFlow id="Flow_FinanceDecision_To_Rejected" name="Rejected" sourceRef="Gateway_FinanceDecision" targetRef="EndEvent_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        = decision = "rejected"
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FinanceDecision_To_Routing" name="Approved" sourceRef="Gateway_FinanceDecision" targetRef="Gateway_AfterFinance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        = decision = "approved"
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FinanceRoute_ManagerFinance_To_Procurement" name="Procurement Next" sourceRef="Gateway_AfterFinance" targetRef="UserTask_ProcurementApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        = approvalLevel = "MANAGER_FINANCE"
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FinanceRoute_ManagerFinanceDirector_To_Director" name="Director Next" sourceRef="Gateway_AfterFinance" targetRef="UserTask_DirectorApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        = approvalLevel = "MANAGER_FINANCE_DIRECTOR"
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Director_To_Decision" sourceRef="UserTask_DirectorApproval" targetRef="Gateway_DirectorDecision" />
    <bpmn:sequenceFlow id="Flow_DirectorDecision_To_Rejected" name="Rejected" sourceRef="Gateway_DirectorDecision" targetRef="EndEvent_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        = decision = "rejected"
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DirectorDecision_To_Procurement" name="Approved" sourceRef="Gateway_DirectorDecision" targetRef="UserTask_ProcurementApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        = decision = "approved"
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Procurement_To_Decision" sourceRef="UserTask_ProcurementApproval" targetRef="Gateway_ProcurementDecision" />
    <bpmn:sequenceFlow id="Flow_ProcurementDecision_To_Rejected" name="Rejected" sourceRef="Gateway_ProcurementDecision" targetRef="EndEvent_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        = decision = "rejected"
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:subProcess id="SubProcess_PostApprovalProcessing" name="Post Approval Processing">
      <bpmn:incoming>Flow_1if7nxc</bpmn:incoming>
      <bpmn:outgoing>Flow_06tp7t7</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_PostApproval" name="Post Approval Started">
        <bpmn:outgoing>Flow_07ycroo</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="Gateway_SubProcess_PostApprovalFork" name="Post Approval Fork">
        <bpmn:incoming>Flow_07ycroo</bpmn:incoming>
        <bpmn:outgoing>Flow_0mzl8kg</bpmn:outgoing>
        <bpmn:outgoing>Flow_1uvmiid</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:sequenceFlow id="Flow_07ycroo" sourceRef="StartEvent_PostApproval" targetRef="Gateway_SubProcess_PostApprovalFork" />
      <bpmn:serviceTask id="ServiceTask_SubProcess_NotifyRequester" name="Notify Requester">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="flowops.procurement.notify-requester" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0mzl8kg</bpmn:incoming>
        <bpmn:outgoing>Flow_099lhii</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_0mzl8kg" sourceRef="Gateway_SubProcess_PostApprovalFork" targetRef="ServiceTask_SubProcess_NotifyRequester" />
      <bpmn:sequenceFlow id="Flow_1uvmiid" sourceRef="Gateway_SubProcess_PostApprovalFork" targetRef="ServiceTask_SubProcess_RecordApprovalAudit" />
      <bpmn:serviceTask id="ServiceTask_SubProcess_RecordApprovalAudit" name="Record Approval Audit">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="flowops.procurement.record-approval-audit" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1uvmiid</bpmn:incoming>
        <bpmn:outgoing>Flow_1pnabw3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="Gateway_SubProcess_PostApprovalJoin" name="Post Approval Join">
        <bpmn:incoming>Flow_1pnabw3</bpmn:incoming>
        <bpmn:incoming>Flow_0j6xrdq</bpmn:incoming>
        <bpmn:outgoing>Flow_0picc31</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:sequenceFlow id="Flow_1pnabw3" sourceRef="ServiceTask_SubProcess_RecordApprovalAudit" targetRef="Gateway_SubProcess_PostApprovalJoin" />
      <bpmn:endEvent id="EndEvent_SubProcess_PostApproval" name="Post Approval Completed">
        <bpmn:incoming>Flow_1u4yy62</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_RequesterAcknowledged" name="Requester Acknowledged">
        <bpmn:incoming>Flow_099lhii</bpmn:incoming>
        <bpmn:outgoing>Flow_0j6xrdq</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1c2mv81" messageRef="Message_06hjh1m" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_099lhii" sourceRef="ServiceTask_SubProcess_NotifyRequester" targetRef="IntermediateCatchEvent_RequesterAcknowledged" />
      <bpmn:sequenceFlow id="Flow_0j6xrdq" sourceRef="IntermediateCatchEvent_RequesterAcknowledged" targetRef="Gateway_SubProcess_PostApprovalJoin" />
      <bpmn:callActivity id="CallActivity_PostApprovalFollowUp" name="Run Post Approval Follow-up">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="purchase-request-follow-up" propagateAllChildVariables="false" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0picc31</bpmn:incoming>
        <bpmn:outgoing>Flow_1u4yy62</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Flow_0picc31" sourceRef="Gateway_SubProcess_PostApprovalJoin" targetRef="CallActivity_PostApprovalFollowUp" />
      <bpmn:sequenceFlow id="Flow_1u4yy62" sourceRef="CallActivity_PostApprovalFollowUp" targetRef="EndEvent_SubProcess_PostApproval" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_1if7nxc" name="Approved" sourceRef="Gateway_ProcurementDecision" targetRef="SubProcess_PostApprovalProcessing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06tp7t7" sourceRef="SubProcess_PostApprovalProcessing" targetRef="EndEvent_Approved" />
    <bpmn:boundaryEvent id="BoundaryEvent_RequesterNotificationError" name="Notification Error" attachedToRef="SubProcess_PostApprovalProcessing">
      <bpmn:outgoing>Flow_065x7oj</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_06dpvzj" errorRef="Error_1t0mftf" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UserTask_ManualNotificationReview" name="Manual Notification Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_065x7oj</bpmn:incoming>
      <bpmn:outgoing>Flow_1ya2xxt</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_065x7oj" sourceRef="BoundaryEvent_RequesterNotificationError" targetRef="UserTask_ManualNotificationReview" />
    <bpmn:sequenceFlow id="Flow_1ya2xxt" sourceRef="UserTask_ManualNotificationReview" targetRef="EndEvent_Approved" />
    <bpmn:boundaryEvent id="BoundaryEvent_ManagerApprovalEscalationTimer" name="Manager Approval SLA Timer" cancelActivity="false" attachedToRef="UserTask_ManagerApproval">
      <bpmn:outgoing>Flow_0hdw0zr</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1ebddzg">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ServiceTask_ManagerApprovalEscalation" name="Manager Approval Escalation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flowops.procurement.manager-approval-escalation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0hdw0zr</bpmn:incoming>
      <bpmn:outgoing>Flow_0cezvy3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_SupervisorSlaReview" name="Supervisor SLA Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0cezvy3</bpmn:incoming>
      <bpmn:outgoing>Flow_SupervisorSlaReview_To_End</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_ManagerApprovalEscalationCompleted" name="Escalation Completed">
      <bpmn:incoming>Flow_SupervisorSlaReview_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_0hdw0zr" sourceRef="BoundaryEvent_ManagerApprovalEscalationTimer" targetRef="ServiceTask_ManagerApprovalEscalation" />
    <bpmn:sequenceFlow id="Flow_0cezvy3" sourceRef="ServiceTask_ManagerApprovalEscalation" targetRef="UserTask_SupervisorSlaReview" />
    <bpmn:sequenceFlow id="Flow_SupervisorSlaReview_To_End" sourceRef="UserTask_SupervisorSlaReview" targetRef="EndEvent_ManagerApprovalEscalationCompleted" />
  </bpmn:process>
  <bpmn:message id="Message_06hjh1m" name="procurement.requester-acknowledged">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=purchaseRequestId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_1t0mftf" name="Requester Notification Unavailable" errorCode="REQUESTER_NOTIFICATION_UNAVAILABLE" />
