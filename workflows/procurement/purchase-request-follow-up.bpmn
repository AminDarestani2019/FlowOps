  <bpmn:process id="purchase-request-follow-up" name="Purchase Request Follow-up" isExecutable="true">
    <bpmn:startEvent id="StartEvent_FollowUp" name="Follow-up Started">
      <bpmn:outgoing>Flow_06tikgj</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:inclusiveGateway id="Gateway_FollowUpInclusiveFork" name="Follow-up Routing">
      <bpmn:incoming>Flow_06tikgj</bpmn:incoming>
      <bpmn:outgoing>Flow_01nt9sv</bpmn:outgoing>
      <bpmn:outgoing>Flow_1r3hgug</bpmn:outgoing>
      <bpmn:outgoing>Flow_04jmmid</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="Flow_06tikgj" sourceRef="StartEvent_FollowUp" targetRef="Gateway_FollowUpInclusiveFork" />
    <bpmn:serviceTask id="ServiceTask_FollowUp_Standard" name="Standard Follow-up">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flowops.procurement.standard-follow-up" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01nt9sv</bpmn:incoming>
      <bpmn:outgoing>Flow_0b8m451</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_01nt9sv" name="Standard" sourceRef="Gateway_FollowUpInclusiveFork" targetRef="ServiceTask_FollowUp_Standard">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="ServiceTask_FollowUp_Finance" name="Finance Follow-up">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flowops.procurement.finance-follow-up" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1r3hgug</bpmn:incoming>
      <bpmn:outgoing>Flow_030xt7v</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1r3hgug" name="Finance" sourceRef="Gateway_FollowUpInclusiveFork" targetRef="ServiceTask_FollowUp_Finance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalLevel = "MANAGER_FINANCE" or approvalLevel = "MANAGER_FINANCE_DIRECTOR"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="ServiceTask_FollowUp_Executive" name="Executive Follow-up">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flowops.procurement.executive-follow-up" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04jmmid</bpmn:incoming>
      <bpmn:outgoing>Flow_08vwuz6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_04jmmid" name="Executive" sourceRef="Gateway_FollowUpInclusiveFork" targetRef="ServiceTask_FollowUp_Executive">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalLevel = "MANAGER_FINANCE_DIRECTOR"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:inclusiveGateway id="Gateway_FollowUpInclusiveJoin" name="Follow-up Join">
      <bpmn:incoming>Flow_08vwuz6</bpmn:incoming>
      <bpmn:incoming>Flow_0b8m451</bpmn:incoming>
      <bpmn:incoming>Flow_030xt7v</bpmn:incoming>
      <bpmn:outgoing>Flow_07nilh5</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="Flow_08vwuz6" sourceRef="ServiceTask_FollowUp_Executive" targetRef="Gateway_FollowUpInclusiveJoin" />
    <bpmn:sequenceFlow id="Flow_0b8m451" sourceRef="ServiceTask_FollowUp_Standard" targetRef="Gateway_FollowUpInclusiveJoin" />
    <bpmn:sequenceFlow id="Flow_030xt7v" sourceRef="ServiceTask_FollowUp_Finance" targetRef="Gateway_FollowUpInclusiveJoin" />
    <bpmn:endEvent id="EndEvent_FollowUpCompleted" name="Follow-up Completed">
      <bpmn:incoming>Flow_07nilh5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_07nilh5" sourceRef="Gateway_FollowUpInclusiveJoin" targetRef="EndEvent_FollowUpCompleted" />
  </bpmn:process>
